  <metadata>
    <id>openlogi</id>
    <version>0.7.1</version>
    <owners>Dennis Gaida</owners>
    <title>OpenLogi</title>
    <authors>AprilNEA</authors>
    <projectUrl>https://openlogi.org/en</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/DennisGaida/chocolatey-packages/main/openlogi/icon.png</iconUrl>
    <packageSourceUrl>https://github.com/DennisGaida/chocolatey-packages/tree/main/openlogi</packageSourceUrl>
    <licenseUrl>https://github.com/AprilNEA/OpenLogi/blob/master/LICENSE-MIT</licenseUrl>
    <projectSourceUrl>https://github.com/AprilNEA/OpenLogi</projectSourceUrl>
